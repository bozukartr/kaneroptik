rules_version = '2';

// Every device shares the one kaner-optik store and opens straight into it, so access
// is granted to any signed-in session (the app signs in anonymously on load) rather
// than to a single named account.
service cloud.firestore {
  match /databases/{database}/documents {
    match /stores/kaner-optik/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
