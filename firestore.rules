rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /stores/kaner-optik/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "admin@kaneroptik.app";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
